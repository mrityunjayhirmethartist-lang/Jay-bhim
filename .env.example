# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ======================== RAZORPAY PAYMENT GATEWAY CONFIGURATION ========================
# Obtain your credentials from https://dashboard.razorpay.com/app/keys
#
# 1. API Keys:
#    - Test Mode: Starts with "rzp_test_..."
#    - Live Mode: Starts with "rzp_live_..."
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourKeySecretHere"

# 2. Webhook Secret:
#    Configure in Razorpay Dashboard -> Settings -> Webhooks
#    Webhook URL: https://<your-domain>/api/razorpay/webhook
#    Subscribed events:
#      - payment.captured
#      - order.paid
#      - payment.failed
#      - subscription.activated
#      - subscription.charged
#      - subscription.cancelled
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# ======================== RUDRAATMA MUSIC HOSTING EMAIL (SMTP) ========================
# Domain: rudraatmamusic.com
# Official Sender: noreply@rudraatmamusic.com
# Support Email: support@rudraatmamusic.com
#
# Configure your hosting provider's actual SMTP credentials below:
# - Standard cPanel / Hostinger / Web Hosting Mail Server:
SMTP_HOST="mail.rudraatmamusic.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@rudraatmamusic.com"
SMTP_PASS="YOUR_HOSTING_EMAIL_PASSWORD"
SMTP_FROM="\"Rudraatma Music\" <noreply@rudraatmamusic.com>"
SMTP_REPLY_TO="rudraatmamusic@gmail.com"

# ======================== HYBRID HOSTING & DATABASE (RENDER + NETLIFY) ========================
# Frontend (Netlify):
VITE_API_BASE_URL="https://rudraatma-music.onrender.com"

# Backend (Render) - Allowed Frontend Origin for CORS:
FRONTEND_URL="https://rudraatma-music.netlify.app"

# Persistent PostgreSQL Database (Required in production; e.g., Render PostgreSQL, Neon, Supabase):
DATABASE_URL="postgresql://user:password@host:5432/rudraatma_music"
DATABASE_SSL="true"

# Optional S3-Compatible Object Storage (Cloudflare R2 / AWS S3 / Backblaze B2) for Audio & Artwork:
# If omitted, uploaded media is persisted in PostgreSQL BYTEA storage (never ephemeral Render disk).
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ======================== SUPER ADMIN EXECUTIVE CREDENTIALS ========================
# Set these in Render / production environment variables (never commit real passwords)
SUPER_ADMIN_EMAIL="rudraatmamusic@gmail.com"
SUPER_ADMIN_PASSWORD=""
# Or provide a pre-computed bcrypt hash instead of plaintext:
SUPER_ADMIN_PASSWORD_HASH=""
# Optional one-time bootstrap secret for POST /api/super-admin/bootstrap
SUPER_ADMIN_BOOTSTRAP_SECRET=""

# ======================== RUDRAATMA AI MUSIC REVIEW & COPYRIGHT RISK DETECTION ========================
ACOUSTID_CLIENT_KEY="YOUR_ACOUSTID_CLIENT_KEY"
CHROMAPRINT_PATH="fpcalc"
FFMPEG_PATH="ffmpeg"
AI_REVIEW_ENABLED="true"
AI_AUTO_APPROVAL_ENABLED="false"
AI_AUTO_REJECTION_ENABLED="false"
AI_REVIEW_CONFIDENCE_THRESHOLD="95"
